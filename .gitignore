# Secrets — the private key is bound to the eSignet client registered per runbook §7.
# Both halves are regenerated together by `node genKeys.js`; committing either is pointless
# and committing the private half is a leak.
private.jwk.json
public.jwk.json
.env

# Fetched by the runbook, not authored here.
# esignet/ is its own git clone (v1.8.0) — tracking it would nest a repo.
# esignet/
wso2is-7.3.0/
wso2is-7.3.0.zip

# Installed from package.json.
node_modules/
npm-debug.log*

# Deliberately not pinned — see CLAUDE.md. Delete this line if you decide to commit the lockfile.
package-lock.json

# setup-without-bridge/: the bridge-free variant, built as a Maven OSGi bundle.
# Its wso2is-7.3.0/, .run/, *.log and the IS zip are already matched by the unanchored
# patterns above; only the build output and its own eSignet clone need adding.
target/
setup-without-bridge/esignet/

# Transient: throwaway CSRF cookie jar from client registration.
cookies.txt

# Runtime output, in case anything is ever run in place here.
*.log
repository/logs/

# macOS
.DS_Store

# demo.sh runtime state: pid files, bridge log, IS start/stop output.
.run/

# citizen-portal-integration/: plan docs, M1 session notes, and local TLS certs.
citizen-portal-integration/*PLAN*.md
citizen-portal-integration/*plan*.md
citizen-portal-integration/M1-SESSION-NOTES.md
citizen-portal-integration/M2-SESSION-NOTES.md
citizen-portal-integration/M3-SESSION-NOTES.md
citizen-portal-integration/M4-SESSION-NOTES.md
citizen-portal-integration/M5-SESSION-NOTES.md
citizen-portal-integration/certs/
PORTAL-INTEGRATION-PLAN.md

CLAUDE.md
