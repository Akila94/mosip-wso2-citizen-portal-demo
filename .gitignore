# Secrets — the private key is bound to the eSignet client registered per runbook §7.
# Both halves are regenerated together by `node genKeys.js`; committing either is pointless
# and committing the private half is a leak.
private.jwk.json
public.jwk.json
.env

# Fetched by the runbook, not authored here.
# esignet/ is its own git clone (v1.8.0) — tracking it would nest a repo. Each variant
# clones into its own folder, and both paths are anchored with a leading slash: an
# unanchored 'esignet/' would also match the connector's Java package directory
# (.../application/authenticator/esignet/) and silently ignore all of its sources.
/esignet-bridge/esignet/
/setup-without-bridge/esignet/
wso2is-7.3.0/
wso2is-7.3.0.zip

# Installed from package.json.
node_modules/
npm-debug.log*

# Deliberately not pinned — see CLAUDE.md. Delete this line if you decide to commit the lockfile.
package-lock.json

# Maven build output of the bridge-free variant's OSGi bundle.
target/

# Transient: throwaway CSRF cookie jar from client registration.
cookies.txt

# Runtime output, in case anything is ever run in place here.
*.log
repository/logs/

# macOS
.DS_Store

# demo.sh runtime state: pid files, bridge log, IS start/stop output.
.run/

CLAUDE.md
