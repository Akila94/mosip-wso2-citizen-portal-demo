# citizen-portal-bff configuration — environment variables only, no config file.
# Copy to .env, fill in the two secrets below, then: go run ./cmd/bff
# .env is gitignored and must be chmod 600 — never commit it.

# --- BFF ---
BFF_PORT=8090
BFF_PUBLIC_URL=http://localhost:8090

# --- WSO2 IS ---
# Must match the exact issuer string IS puts in its ID tokens' `iss` claim
# (verified for a default super-tenant IS 7.3.0 install).
IS_ISSUER=https://localhost:9443/oauth2/token
# IS's self-signed cert, exported per citizen-portal-integration/certs/README.md.
IS_CA_FILE=../certs/wso2is-local.pem

# --- Citizen Portal application (M1) ---
# Register this application first — see citizen-portal-integration/MANUAL-STEPS.md.
# There is no default: the process refuses to start without both values set.
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_CLIENT_SCOPES=openid profile email

# --- Sessions ---
# Must not be shorter than the IS SSO idle timeout (patched to 60m by
# setup-without-bridge/demo.sh) — a shorter value here silently defeats the
# SSO demo by expiring the BFF's own session before IS's.
SESSION_IDLE_TIMEOUT=60m
SESSION_MAX_ENTRIES=5000
LOGIN_TXN_TTL=5m

# --- Reserved for M4/M5 (SPA dev proxy / static serving) — unused in M1 ---
DEV_PROXY_TARGET=
STATIC_DIR=../../citizen-portal-demo-app/dist

# --- Misc ---
# Defaults to true when BFF_PUBLIC_URL is https://, false otherwise. Set
# explicitly only to override that inference (e.g. behind a TLS-terminating
# reverse proxy in front of a plain-http origin).
# COOKIE_SECURE=true
LOG_LEVEL=info
