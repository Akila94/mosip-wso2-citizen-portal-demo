# gov-services-api configuration — environment variables only, no config file.
# Copy to .env, fill in the three client IDs below, then: ./run-govapi.sh
# .env is gitignored and must be chmod 600 — never commit it.
#
# This service holds no secrets of its own: it only validates access tokens
# presented to it, it never authenticates to anything. The three client IDs
# below are not secrets — they are the same PORTAL_CLIENT_ID / DL_CLIENT_ID /
# VRL_CLIENT_ID values already sitting in citizen-portal-bff/.env (copy them
# from there, or from the Console's Protocol tab per MANUAL-STEPS.md §1/§3/§4)
# — this service uses them as the expected `aud` for each router, never as
# credentials.

# --- gov-services-api ---
SERVICES_PORT=8091

# --- WSO2 IS ---
# Must match citizen-portal-bff/.env's IS_ISSUER exactly — both services
# validate tokens issued by the same IS instance.
IS_ISSUER=https://localhost:9443/oauth2/token
# IS's self-signed cert, same file citizen-portal-bff uses.
IS_CA_FILE=../certs/wso2is-local.pem

# --- Expected audiences (one per router) ---
# There is no default for any of these: the process refuses to start
# without all three set, so a misconfigured audience fails loudly at boot
# rather than rejecting every request to that router at demo time.
PORTAL_CLIENT_ID=
DL_CLIENT_ID=
VRL_CLIENT_ID=

# --- Misc ---
LOG_LEVEL=info
